NODE_ENV=development
PORT=4001
MONGODB_URI=mongodb://localhost:27017/sareeshop
JWT_SECRET=change-this-to-a-long-random-secret
FRONTEND_URL=http://localhost:3000

# Razorpay (get from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Shiprocket (get from https://app.shiprocket.in)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=

# Image storage (optional for v1)
CLOUDINARY_URL=

# Public URL for uploaded spin assets (optional, defaults to localhost)
API_PUBLIC_URL=http://localhost:4001
